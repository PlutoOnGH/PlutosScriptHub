local SettingsTab = Window:CreateTab("Settings")

local CONFIG_ROOT = "PlutosScriptHub"
local CONFIG_FOLDER = CONFIG_ROOT .. "/Configs"
local AUTOLOAD_PATH = CONFIG_ROOT .. "/autoload.json"

local ConfigName = "99 Nights Config"
local SelectedConfigName = ""
local AutoLoadEnabled = false
local AutoLoadConfigName = ""
local ConfigDropdown
local AutoLoadToggle

local function FileApiAvailable()
    return typeof(writefile) == "function"
        and typeof(readfile) == "function"
        and typeof(listfiles) == "function"
        and typeof(makefolder) == "function"
end

local function EnsureConfigFolders()
    if not FileApiAvailable() then
        return false
    end

    pcall(function()
        if typeof(isfolder) ~= "function" or not isfolder(CONFIG_ROOT) then
            makefolder(CONFIG_ROOT)
        end
        if typeof(isfolder) ~= "function" or not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end
    end)

    return true
end

local function CleanConfigName(name)
    name = tostring(name or "")
    name = name:gsub("%.json$", "")
    name = name:gsub("[^%w%-%_ ]", "")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub("%s+", "_")
    return name:sub(1, 40)
end

local function ConfigPath(name)
    return CONFIG_FOLDER .. "/" .. CleanConfigName(name) .. ".json"
end

local function ListSavedConfigs()
    local names = {}

    if not EnsureConfigFolders() then
        return names
    end

    local ok, files = pcall(listfiles, CONFIG_FOLDER)
    if not ok or type(files) ~= "table" then
        return names
    end

    for _, path in ipairs(files) do
        local filename = tostring(path):match("([^/\\]+)$")
        local name = filename and filename:match("(.+)%.json$")
        if name and name ~= "autoload" then
            table.insert(names, name)
        end
    end

    table.sort(names)
    return names
end

local function SaveAutoLoadSetting()
    if not EnsureConfigFolders() then
        return false
    end

    return pcall(function()
        writefile(AUTOLOAD_PATH, HttpService:JSONEncode({
            Enabled = AutoLoadEnabled,
            ConfigName = AutoLoadConfigName
        }))
    end)
end

local function CurrentConfigData()
    return {
        PlayerESPToggle = ESPEnabled,
        ESPOpacitySlider = ESPOpacity,
        WalkSpeedToggle = WalkSpeedEnabled,
        WalkSpeedSlider = WalkSpeedValue,
        InstantPromptToggle = InstantPromptEnabled,
        FullBrightToggle = FullBrightEnabled
    }
end

local function ApplyConfig(data)
    if type(data) ~= "table" then
        return
    end

    if type(data.ESPOpacitySlider) == "number" then
        ESPOpacity = math.clamp(data.ESPOpacitySlider, 0, 100)
    end

    if type(data.PlayerESPToggle) == "boolean" then
        ESPEnabled = data.PlayerESPToggle
        if ESPEnabled then
            RefreshESP()
        end
        UpdateESP()
        pcall(function()
            PlayerESPToggle:Set(ESPEnabled)
        end)
    end

    if type(data.WalkSpeedSlider) == "number" then
        WalkSpeedValue = math.clamp(data.WalkSpeedSlider, 16, 100)
        ApplyWalkSpeed()
    end

    if type(data.WalkSpeedToggle) == "boolean" then
        SetWalkSpeedEnabled(data.WalkSpeedToggle)
        pcall(function()
            WalkSpeedToggle:Set(WalkSpeedEnabled)
        end)
    end

    if type(data.InstantPromptToggle) == "boolean" then
        InstantPromptToggle:Set(data.InstantPromptToggle)
    end

    if type(data.FullBrightToggle) == "boolean" then
        FullBrightToggle:Set(data.FullBrightToggle)
    end
end

local function RefreshConfigDropdown()
    local names = ListSavedConfigs()
    local options = #names > 0 and names or {"No saved configs"}

    if ConfigDropdown and type(ConfigDropdown.Refresh) == "function" then
        pcall(function()
            ConfigDropdown:Refresh(options, true)
        end)
    end

    if SelectedConfigName ~= "" and not table.find(names, SelectedConfigName) then
        SelectedConfigName = ""
    end
end

local function SaveConfig(name)
    name = CleanConfigName(name or ConfigName)

    if name == "" then
        Notify("Configs", "Enter a config name before saving.")
        return false
    end

    if not EnsureConfigFolders() then
        Notify("Configs", "Required executor file APIs are unavailable.")
        return false
    end

    local ok, err = pcall(function()
        writefile(ConfigPath(name), HttpService:JSONEncode(CurrentConfigData()))
    end)

    if not ok then
        Notify("Config Error", tostring(err))
        return false
    end

    SelectedConfigName = name
    RefreshConfigDropdown()
    Notify("Configs", "Saved config: " .. name)
    return true
end

local function LoadConfig(name, silent)
    name = CleanConfigName(name)

    if name == "" or not EnsureConfigFolders() then
        if not silent then
            Notify("Configs", "Select a config and check file API support.")
        end
        return false
    end

    local path = ConfigPath(name)
    local exists = false

    if typeof(isfile) == "function" then
        local ok, result = pcall(isfile, path)
        exists = ok and result
    else
        exists = pcall(readfile, path)
    end

    if not exists then
        if not silent then
            Notify("Configs", "Config not found: " .. name)
        end
        return false
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if not ok or type(data) ~= "table" then
        if not silent then
            Notify("Configs", "That config file is invalid.")
        end
        return false
    end

    ApplyConfig(data)
    SelectedConfigName = name

    if not silent then
        Notify("Configs", "Loaded config: " .. name)
    end

    return true
end

SettingsTab:CreateParagraph({
    Title = "Configuration Manager",
    Content = "Save and load named settings. Auto-Load applies the selected config when the script starts."
})

SettingsTab:CreateInput({
    Name = "Config Name",
    CurrentValue = ConfigName,
    PlaceholderText = "Enter a config name",
    RemoveTextAfterFocusLost = false,
    Flag = "ConfigNameInput",
    Callback = function(value)
        ConfigName = tostring(value or "")
    end
})

local initialNames = ListSavedConfigs()
local initialOptions = #initialNames > 0 and initialNames or {"No saved configs"}

if #initialNames > 0 then
    SelectedConfigName = initialNames[1]
end

ConfigDropdown = SettingsTab:CreateDropdown({
    Name = "Saved Configs",
    Options = initialOptions,
    CurrentOption = {initialOptions[1]},
    MultipleOptions = false,
    Flag = "SavedConfigDropdown",
    Callback = function(option)
        SelectedConfigName = type(option) == "table"
            and tostring(option[1] or "")
            or tostring(option or "")

        if SelectedConfigName == "No saved configs" then
            SelectedConfigName = ""
        end

        if AutoLoadEnabled and SelectedConfigName ~= "" then
            AutoLoadConfigName = SelectedConfigName
            SaveAutoLoadSetting()
        end
    end
})

SettingsTab:CreateButton({
    Name = "Save Config",
    Callback = function()
        SaveConfig(ConfigName)
    end
})

SettingsTab:CreateButton({
    Name = "Load Selected Config",
    Callback = function()
        LoadConfig(SelectedConfigName, false)
    end
})

SettingsTab:CreateButton({
    Name = "Refresh Config List",
    Callback = function()
        RefreshConfigDropdown()
        Notify("Configs", "Config list refreshed.")
    end
})

AutoLoadToggle = SettingsTab:CreateToggle({
    Name = "Auto-Load Selected Config",
    CurrentValue = false,
    Flag = "AutoLoadConfigToggle",
    Callback = function(value)
        if value and SelectedConfigName == "" then
            AutoLoadEnabled = false
            Notify("Configs", "Select a saved config before enabling auto-load.")

            task.defer(function()
                pcall(function()
                    AutoLoadToggle:Set(false)
                end)
            end)

            return
        end

        AutoLoadEnabled = value
        AutoLoadConfigName = value and SelectedConfigName or ""

        if SaveAutoLoadSetting() then
            Notify(
                "Configs",
                value
                    and ("Auto-load enabled for: " .. AutoLoadConfigName)
                    or "Auto-load disabled."
            )
        else
            Notify("Configs", "Could not save the auto-load setting.")
        end
    end
})

task.defer(function()
    task.wait(1)

    if not EnsureConfigFolders() then
        return
    end

    local ok, saved = pcall(function()
        if typeof(isfile) == "function" and not isfile(AUTOLOAD_PATH) then
            return nil
        end
        return HttpService:JSONDecode(readfile(AUTOLOAD_PATH))
    end)

    if ok
        and type(saved) == "table"
        and saved.Enabled == true
        and type(saved.ConfigName) == "string" then

        AutoLoadEnabled = true
        AutoLoadConfigName = saved.ConfigName
        SelectedConfigName = saved.ConfigName

        pcall(function()
            AutoLoadToggle:Set(true)
        end)

        LoadConfig(AutoLoadConfigName, true)
    end
end)

