local function ConnectPlayer(player)
    if player == LocalPlayer then
        return
    end

    player.CharacterAdded:Connect(function()
        task.wait(1)
        if ESPEnabled then
            CreateESP(player)
        end
    end)

    player.CharacterRemoving:Connect(function()
        RemoveESP(player)
    end)

    if ESPEnabled and player.Character then
        CreateESP(player)
    end
end

Players.PlayerAdded:Connect(ConnectPlayer)
Players.PlayerRemoving:Connect(RemoveESP)

for _, player in ipairs(Players:GetPlayers()) do
    ConnectPlayer(player)
end

-- Walk speed

local WalkSpeedEnabled = false
local WalkSpeedValue = 32
local OriginalWalkSpeed
local WalkSpeedConnection

local function ApplyWalkSpeed()
    if not WalkSpeedEnabled then
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        if OriginalWalkSpeed == nil then
            OriginalWalkSpeed = humanoid.WalkSpeed
        end
        humanoid.WalkSpeed = WalkSpeedValue
    end
end

local function SetWalkSpeedEnabled(value)
    WalkSpeedEnabled = value

    if WalkSpeedConnection then
        WalkSpeedConnection:Disconnect()
        WalkSpeedConnection = nil
    end

    if value then
        OriginalWalkSpeed = nil
        ApplyWalkSpeed()

        WalkSpeedConnection = LocalPlayer.CharacterAdded:Connect(function(character)
            OriginalWalkSpeed = nil
            character:WaitForChild("Humanoid", 5)
            task.wait(0.1)
            ApplyWalkSpeed()
        end)
    else
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if humanoid and OriginalWalkSpeed then
            humanoid.WalkSpeed = OriginalWalkSpeed
        end

        OriginalWalkSpeed = nil
    end
end

local WalkSpeedToggle = PlayerTab:CreateToggle({
    Name = "Walk Speed",
    CurrentValue = false,
    Flag = "WalkSpeedToggle",
    Callback = SetWalkSpeedEnabled
})

PlayerTab:CreateSlider({
    Name = "Walk Speed Amount",
    Range = {16, 100},
    Increment = 1,
    Suffix = "Speed",
    CurrentValue = WalkSpeedValue,
    Flag = "WalkSpeedSlider",
    Callback = function(value)
        WalkSpeedValue = value
        ApplyWalkSpeed()
    end
})

-- Instant proximity prompt

local InstantPromptEnabled = false
local OriginalPromptDurations = {}

local function UpdatePrompt(prompt)
    if prompt:IsA("ProximityPrompt") and InstantPromptEnabled then
        if OriginalPromptDurations[prompt] == nil then
            OriginalPromptDurations[prompt] = prompt.HoldDuration
        end

        pcall(function()
            prompt.HoldDuration = 0
        end)
    end
end

local InstantPromptToggle = PlayerTab:CreateToggle({
    Name = "Instant Proximity Prompt",
    CurrentValue = false,
    Flag = "InstantPromptToggle",
    Callback = function(value)
        InstantPromptEnabled = value

        if value then
            for _, object in ipairs(workspace:GetDescendants()) do
                UpdatePrompt(object)
            end
            Notify("Prompts", "Instant prompt enabled.")
        else
            for prompt, duration in pairs(OriginalPromptDurations) do
                if prompt and prompt.Parent then
                    pcall(function()
                        prompt.HoldDuration = duration
                    end)
                end
            end
            table.clear(OriginalPromptDurations)
        end
    end
})

workspace.DescendantAdded:Connect(UpdatePrompt)

-- Full bright

local FullBrightEnabled = false
local OriginalLighting

local function SetFullBright(value)
    FullBrightEnabled = value

    if value then
        if not OriginalLighting then
            OriginalLighting = {
                Brightness = Lighting.Brightness,
                ClockTime = Lighting.ClockTime,
                FogEnd = Lighting.FogEnd,
                GlobalShadows = Lighting.GlobalShadows,
                Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient
            }
        end

        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    elseif OriginalLighting then
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.ClockTime = OriginalLighting.ClockTime
        Lighting.FogEnd = OriginalLighting.FogEnd
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        OriginalLighting = nil
    end
end

local FullBrightToggle = PlayerTab:CreateToggle({
    Name = "Full Bright",
    CurrentValue = false,
    Flag = "FullBrightToggle",
    Callback = SetFullBright
})

