local TrickOrTreatTab = Window:CreateTab("🎃 Trick or Treat")
local KnockRemote = ReplicatedStorage
    :WaitForChild("RemoteEvents")
    :WaitForChild("RequestKnockOnDoor")

local function KnockOnHouse(path, label)
    local current = workspace

    for _, name in ipairs(path) do
        current = current:WaitForChild(name, 5)

        if not current then
            Notify("Trick or Treat", label .. " could not be found.")
            return
        end
    end

    local functional = current:WaitForChild("Functional", 5)
    local door = functional and functional:WaitForChild("Door", 5)

    if not door then
        Notify("Trick or Treat", label .. " door could not be found.")
        return
    end

    local ok, result, message = pcall(function()
        return KnockRemote:InvokeServer(door)
    end)

    if not ok then
        Notify("Trick or Treat", "Knock request failed: " .. tostring(result))
    elseif result == false then
        Notify("Trick or Treat", message or "The server rejected the request.")
    else
        Notify("Trick or Treat", "Knocked on " .. label .. ".")
    end
end

